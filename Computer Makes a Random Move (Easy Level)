import java.util.Random;

class ComputerMove {

    // Reuse validation method
    public static boolean isValidMove(char[][] board, int row, int col) {
        return (row >= 0 && row < 3 && col >= 0 && col < 3 && board[row][col] == ' ');
    }

    // Reuse place move method
    public static void placeMove(char[][] board, int row, int col, char symbol) {
        board[row][col] = symbol;
    }

    // Computer random move
    public static void computerMove(char[][] board, char symbol) {
        Random rand = new Random();
        int slot, row, col;

        // Loop until valid move found
        while (true) {
            slot = rand.nextInt(9) + 1; // 1–9

            row = (slot - 1) / 3;
            col = (slot - 1) % 3;

            if (isValidMove(board, row, col)) {
                placeMove(board, row, col, symbol);
                System.out.println("Computer chose slot: " + slot);
                break;
            }
        }
    }

    // Display board
    public static void printBoard(char[][] board) {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + " ");
            }
            System.out.println();
        }
    }

    // Demo main
    public static void main(String[] args) {

        char[][] board = {
            {'X', 'O', ' '},
            {' ', 'X', ' '},
            {'O', ' ', ' '}
        };

        computerMove(board, 'O');
        printBoard(board);
    }
}
